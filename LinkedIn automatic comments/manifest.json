{
  "manifest_version": 3,
  "name": "LinkedIn automatic comments",
  "description": "Auto-Comment on LinkedIn Posts",
  "version": "1.3.8",
  "author": "RocketPod Technologies Inc.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.plasmo.496a292f.png",
      "32": "icon32.plasmo.3b8fa2e2.png",
      "48": "icon48.plasmo.843a0c18.png",
      "64": "icon64.plasmo.d2c351f8.png",
      "128": "icon128.plasmo.d580fdc7.png"
    }
  },
  "icons": {
    "16": "icon16.plasmo.496a292f.png",
    "32": "icon32.plasmo.3b8fa2e2.png",
    "48": "icon48.plasmo.843a0c18.png",
    "64": "icon64.plasmo.d2c351f8.png",
    "128": "icon128.plasmo.d580fdc7.png"
  },
  "background": {
    "service_worker": "static/background/index.js"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "runtime.patch.js",
        "contents.f6a134c0.js"
      ],
      "css": []
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "css": [
        "iziToast.min.0fb6f6b0.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "resources": [
        "assets/*"
      ]
    }
  ]
}
