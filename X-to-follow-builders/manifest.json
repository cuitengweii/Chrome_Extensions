{
  "manifest_version": 3,
  "name": "\u7a7a\u6765Ai-X\u65e5\u62a5\u8d26\u53f7\u91c7\u96c6\u5668",
  "version": "0.5.1",
  "description": "\u91c7\u96c6 X/YouTube \u8d26\u53f7\u5e76\u5728 Supabase \u4e2d\u7ba1\u7406\u96c6\u5408\u4e0e\u8d26\u53f7\u6c60\u3002",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://fmlneautjackwrcoaevo.supabase.co/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "x-copy-capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "\u7a7a\u6765Ai-X\u65e5\u62a5\u8d26\u53f7\u91c7\u96c6\u5668"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
